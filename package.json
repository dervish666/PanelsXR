{
  "name": "panels-xr",
  "private": true,
  "version": "0.2.3",
  "type": "module",
  "description": "Panel — a WebXR comic reader that streams a Komga library into a VR headset.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dervish666/PanelsXR.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host",
    "dev:quest": "HTTPS=true vite --host",
    "dev:worker": "npm run build:worker && wrangler dev",
    "build": "tsc --noEmit && vite build",
    "build:worker": "tsc --noEmit && tsc -p worker/tsconfig.json --noEmit && VITE_BYO=1 vite build",
    "deploy": "npm run build:worker && wrangler deploy",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit && tsc -p worker/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource/archivo-black": "^5.2.8",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/handle": "^6.6.30",
    "@react-three/xr": "^6.6.30",
    "jszip": "^3.10.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260712.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^3.2.6",
    "wrangler": "^4.110.0"
  }
}
